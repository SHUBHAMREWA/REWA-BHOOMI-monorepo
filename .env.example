# =============================================================================
# REWA BHOOMI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# =============================================================================

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://rewabhoomi:rewabhoomi_dev@localhost:5432/rewabhoomi
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-this-to-a-very-long-secret-key-minimum-32-chars-access
JWT_REFRESH_SECRET=change-this-to-a-very-long-secret-key-minimum-32-chars-refresh

# ─── Google OAuth (fill when ready) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── SMTP Email ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Rewa Bhoomi" <noreply@rewabhoomi.com>

# ─── Cloudflare R2 (fill when ready) ─────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
CLOUDFLARE_BUCKET=rewa-bhoomi-media
CLOUDFLARE_PUBLIC_URL=https://your-custom-domain.com

# ─── WebRTC / TURN (fill when ready) ─────────────────────────────────────────
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ─── Frontend (Next.js public vars) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
