{
  "name": "@rewa-bhoomi/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:admin": "tsx src/database/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@rewa-bhoomi/config": "workspace:*",
    "@rewa-bhoomi/types": "workspace:*",
    "@rewa-bhoomi/validation": "workspace:*",
    "argon2": "^0.41.0",
    "aws-sdk": "^2.1692.0",
    "bullmq": "^5.7.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.33.4",
    "slugify": "^1.6.9",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
