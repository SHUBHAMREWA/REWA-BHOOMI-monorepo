{
  "name": "rewa-bhoomi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @rewa-bhoomi/api dev",
    "dev:web": "pnpm --filter @rewa-bhoomi/web dev",
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:migrate": "pnpm --filter @rewa-bhoomi/api db:migrate",
    "db:seed": "pnpm --filter @rewa-bhoomi/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

